{
  "name": "deluge-companion-dataset-generator",
  "version": "1.0.0",
  "description": "Generates the optimized Pokémon database consumed by the Deluge Companion Chrome extension.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "fetch": "tsx src/index.ts fetch",
    "normalize": "tsx src/index.ts normalize",
    "merge": "tsx src/index.ts merge",
    "score": "tsx src/index.ts score",
    "validate": "tsx src/index.ts validate",
    "generate": "tsx src/index.ts generate",
    "compress": "tsx src/index.ts compress",
    "metadata": "tsx src/index.ts metadata",
    "build-db": "tsc && node dist/index.js build-db",
    "build": "tsc && node dist/index.js build",
    "serve": "tsc && node dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
