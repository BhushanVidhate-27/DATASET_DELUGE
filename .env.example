# Base URL for the public Pokémon dataset (PokéAPI).
# The dataset generator is the ONLY component that talks to this source.
# The Chrome extension never contacts it.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# HTTP concurrency for the fetch stage (requests in flight at once).
FETCH_CONCURRENCY=8

# Delay between batches of requests in milliseconds (0 = disabled).
FETCH_DELAY_MS=0

# Number of times a failed fetch is retried before giving up.
FETCH_RETRIES=3

# Delay before a retry, in milliseconds.
FETCH_RETRY_DELAY_MS=1000

# Version published for this build of the database.
DATASET_VERSION=1.0.0

# Minimum version of the Deluge Companion extension required to consume this database.
MIN_EXTENSION_VERSION=1.0.0

# Base URL where the database file will be hosted (used in version.json -> downloadURL).
DOWNLOAD_BASE_URL=https://example.com/deluge-db