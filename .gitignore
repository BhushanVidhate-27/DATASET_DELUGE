# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local

# Raw downloaded data (regenerated by `pnpm fetch`)
raw/

# Intermediate stage handoffs (regenerated by each pipeline stage)
intermediate/

# Final generated output (regenerated by `pnpm build-db`)
# For Vercel static hosting, generated/ is committed to the repo.
# The GitHub Actions workflow rebuilds and re-commits on tag push.
generated/.gitkeep

# Test coverage
coverage/

# OS / editor cruft
.DS_Store
*.log